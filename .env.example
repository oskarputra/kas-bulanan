# --- Supabase ---------------------------------------------------------------
# Ambil dari Supabase: tombol "Connect" di dashboard project.
#
# DATABASE_URL: "Transaction pooler" (port 6543). Dipakai aplikasi, cocok untuk Vercel.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# DIRECT_URL: "Session pooler" (port 5432). Dipakai untuk migrasi (npm run db:migrate).
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- Postgres lokal (opsional, mis. dengan docker compose) ------------------
# DATABASE_URL=postgres://kas:kas@localhost:5432/kas_bulanan
# (kosongkan DIRECT_URL)

# Zona waktu untuk menentukan "hari ini"
APP_TZ=Asia/Jakarta
